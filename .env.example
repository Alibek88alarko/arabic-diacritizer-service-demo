API_HOST=127.0.0.1
API_PORT=8080
DB_PATH=data/diacritizer.db
LOG_DIR=logs

# Shared secret presented by the ASP.NET API in the X-Service-Key header. Rotation: put the new key here,
# move the old one to SERVICE_KEY_PREVIOUS, deploy both sides, then clear SERVICE_KEY_PREVIOUS.
SERVICE_KEY=change-me
SERVICE_KEY_PREVIOUS=

# Providers, comma separated, tried in order. "stub" is an offline stand-in for tests only.
# Production example: PROVIDERS=openai,anthropic
PROVIDERS=stub
PROVIDER_TIMEOUT_S=8
PROVIDER_RETRIES=1
MAX_CHARS=2000
DAILY_CHAR_BUDGET=200000

# Any OpenAI-compatible endpoint (OpenAI, Azure OpenAI, DeepSeek, a local server)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
